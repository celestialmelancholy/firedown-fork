<?xml version="1.0" encoding="utf-8"?>
<!--
    Active-tab card for the tab-tray grid: a 4dp brand-orange gradient ring
    (border.heaviest width, the same stroke weight Firefox uses — just
    recolored to our brand orange). No surface wash — the card keeps the
    plain nova_gray65 fill (the border-only convention).

    Ring built as a layer-list: a full orange gradient rect with 16dp
    corners, then the card surface (nova_gray65) inset by 4dp with matching
    corners — the 4dp of gradient left visible IS the border.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tab_card_radius" />
            <gradient
                android:angle="96"
                android:startColor="@color/brand_orange"
                android:endColor="@color/brand_orange_dark"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:top="4dp"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/nova_gray65" />
        </shape>
    </item>
</layer-list>
