<!-- Exact copy of Firefox's tab-tray fade-in (reverse of fade_out, used
     when returning to the browser). Source: mozilla-firefox/firefox
     mobile/android/fenix/app/src/main/res/anim/fade_in.xml -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
       android:interpolator="@android:interpolator/decelerate_quad"
       android:fromAlpha="0.0" android:toAlpha="1.0"
       android:duration="250" />
