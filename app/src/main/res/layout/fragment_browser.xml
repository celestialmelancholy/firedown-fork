<?xml version="1.0" encoding="utf-8"?>
<!--
    FRAMED chrome (Fenix-style), not immersive-under-bars. The root pads
    itself on ALL FOUR sides by the system-bar insets (BrowserFragment's
    root insets listener), so every child — toolbar, engine, bottom bar,
    FAB — lives strictly INSIDE the safe area. The status/nav strips are
    this view's own background showing through that padding (painted the
    chrome tone in resetWindowTheme / applyIncognitoTheme), i.e. an opaque
    frame. clipToPadding stays at its default TRUE: a bar scroll-hiding
    translates up/down INTO the padding region and is clipped clean at the
    frame edge — it never draws over the status icons. This retires the
    dead-zone the old self-padded toolbar had (it travelled height+inset
    while the viewport only reclaimed height, so the bars never fully hid
    on a normal scroll); now the bars are a true app_bar_size tall, which
    MATCHES the content-only heights NestedGeckoViewBehavior already uses,
    so bar travel == reclaimed viewport and the bars hide on a short flick.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <com.solarized.firedown.geckoview.GeckoSwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.solarized.firedown.geckoview.NestedGeckoView
            android:id="@+id/geckoview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.solarized.firedown.geckoview.GeckoSwipeRefreshLayout>


    <com.solarized.firedown.geckoview.GeckoToolbar
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_anchor="@id/toolbar_layout"
        android:clickable="true"
        android:focusable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:visibility="gone"/>

    <View
        android:id="@+id/anchor_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/transparent"
        android:layout_gravity="bottom"
        app:layout_behavior="com.solarized.firedown.geckoview.toolbar.AnchorBehavior"/>



    <!--
        The single top bar (Item 2): the toolbar hosts shield → address pill →
        flame download → + → tab counter → menu. There is NO bottom bar; this
        view remains as a zero-height, GONE controller so AnchorBehavior
        (snackbar anchoring), BottomNavigationBehavior (scroll follower),
        NestedGeckoViewBehavior and FindViewUtils keep working unchanged.
    -->
    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:hideMiddleSlot="true"
        app:selfPadSystemBars="false" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>
