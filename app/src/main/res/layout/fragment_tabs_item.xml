<?xml version="1.0" encoding="utf-8"?>
<!--
  Firefox-exact tab-tray grid card, copied 1:1 from mozilla-firefox/firefox
  TabGridTabItem.kt + SharedTabItemUi.kt + Acorn tokens:

    - Card shape  = MaterialTheme.shapes.large = 16dp (tab_card_radius)
    - Aspect ratio= gridItemAspectRatio = 0.8f portrait (4:5), 1f landscape
    - Container   = surfaceBright (bg_tab_item / bg_tab_item_active)
    - Active tab  = 4dp gradient border Violet30->Violet50 at 96°
    - Header      = 12dp favicon + static100(10dp) + title + static50(5dp) + 40dp close
    - Thumbnail   = RoundedCornerShape(top 4dp, bottom 12dp), 5dp margins (static50)

  The MaterialCardView stays the R.id.tab_item root so the adapter's
  setCardBackgroundColor / setStroke calls keep working; its own fill is
  transparent and the surface/active-gradients live on the FrameLayout
  background (bg_tab_item / bg_tab_item_active), swapped by
  applySelectionChrome.

  Root uses AspectRatioConstraintLayout so item height is purely a
  function of item width (0.8 -> aspectRatio=0.8). A thumbnail load
  inside the card calls requestLayout to re-evaluate its bounds; with a
  plain wrap_content root + child dimension-ratio chain that re-evaluation
  could nudge the measured item height and let GridLayoutManager re-anchor
  the grid a few hundred ms after the page appeared — the "active tab
  slides down" the user reports. Clamping the height at the root with
  EXACTLY MeasureSpec stops that propagation.
-->
<com.solarized.firedown.ui.AspectRatioConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:aspectRatio="0.8">

    <FrameLayout
        android:id="@+id/tab_card_surface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:background="@drawable/bg_tab_item"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tab_item"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/tab_card_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Header row: favicon + spacer + title + spacer + close (Firefox TabGridTabItem.Header) -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/tab_icon"
                    android:layout_width="@dimen/tab_header_favicon"
                    android:layout_height="@dimen/tab_header_favicon"
                    android:layout_marginStart="@dimen/tab_header_spacer"
                    android:background="@drawable/mask_icon_rounded"
                    android:scaleType="fitXY"
                    app:layout_constraintBottom_toTopOf="@id/header_guideline"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/tab_media_indicator"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="2dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/play_circle_24"
                    app:tint="@color/white"
                    app:layout_constraintBottom_toTopOf="@id/header_guideline"
                    app:layout_constraintStart_toEndOf="@id/tab_icon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tab_title"
                    style="@style/TextAppearance.Material3.LabelMedium"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/tab_header_spacer_small"
                    android:layout_marginEnd="@dimen/tab_header_spacer_small"
                    android:ellipsize="none"
                    android:fadingEdgeLength="20dp"
                    android:gravity="center_vertical"
                    android:requiresFadingEdge="horizontal"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    app:layout_constraintBottom_toTopOf="@id/header_guideline"
                    app:layout_constraintEnd_toStartOf="@id/tab_close"
                    app:layout_constraintStart_toEndOf="@id/tab_media_indicator"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Mozilla" />

                <!-- Hidden data holder -->
                <TextView
                    android:id="@+id/tab_url"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Firefox close button: 40dp touch target (TabHeaderIconTouchTargetSize),
                     cross icon at ~20dp, tinted onSurface. -->
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/tab_close"
                    android:layout_width="@dimen/tab_header_close_touch"
                    android:layout_height="@dimen/tab_header_close_touch"
                    android:layout_marginEnd="@dimen/tab_header_spacer_small"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:focusable="false"
                    android:padding="10dp"
                    android:tint="?attr/colorOnSurface"
                    app:srcCompat="@drawable/ic_baseline_close_24"
                    app:layout_constraintBottom_toTopOf="@id/header_guideline"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Guideline separating header from thumbnail area (Firefox header height) -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/header_guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="40dp" />

                <!-- Thumbnail: Firefox thumbnailShape = top extraSmall(4dp) / bottom medium(12dp),
                     with 5dp margins (static50). -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/tab_thumbnail"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="@dimen/tab_thumb_margin"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/FirefoxTabThumbnail"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/header_guideline" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</com.solarized.firedown.ui.AspectRatioConstraintLayout>
