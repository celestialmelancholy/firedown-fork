<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScroll="false">

        <com.solarized.firedown.geckoview.GeckoToolbar
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            app:enableHome="true" />

        <!-- Thin edge-to-edge divider under the search box (Firefox home: the
             app bar's bottom border, ~0.5dp, matching the card surface grey). -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/home_divider" />

    </com.google.android.material.appbar.AppBarLayout>


    <!--
        MINIMAL home (a slick private browser; downloading is a quiet superpower,
        not a billboard). Top→bottom: the functional URL bar (GeckoToolbar, in the
        AppBarLayout above), then a brand block + a single live stat line
        (trackers blocked · total saved). There is deliberately NO downloads
        carousel, Safe Folder card, Trackers card, or Continue-browsing card here
        — the search bar is the home, tabs live behind the bottom-bar tab button,
        downloads behind the download button (badge), the Captured sheet fills as
        you browse, and the trackers stat is folded into the privacy line.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <!-- The minimalist home is a single calm, centred brand mark — the flame
             logo + wordmark — and nothing else. No stats, shortcuts, recents, or
             active-download strip; tabs and the downloads badge live in the
             bottom bar, the vault in the menu. The FrameLayout (stretched to the
             viewport by the NestedScrollView's fillViewport) centres the mark via
             layout_gravity. -->
        <!-- Firefox-style home (Item 1): branding header → shortcuts grid →
             tracker capsule → "Jump back in" recents card. The middle content
             is replaced; the URL bar (above) and bottom bar (below) are
             untouched and will be restyled in Item 2. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/home_brand_mark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <!-- Branding header: logo + name left, incognito icon right.
                     Gap below the divider. Now that home_brand_mark is top-
                     aligned (layout_gravity=top, not center_vertical — the
                     centering used to override ALL padding), this paddingTop
                     actually controls the gap. ~20dp per the original spec. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_waves_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:letterSpacing="-0.02"
                        android:text="@string/app_name"
                        android:textColor="@color/home_header_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/home_private_infinity"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/home_private_mode"
                        android:focusable="true"
                        android:src="@drawable/ic_incognito_24"
                        app:tint="@color/home_header_text" />
                </LinearLayout>

                <!-- Shortcuts section header — shown only when there are
                     most-visited sites; "Show all >" only with multiple. -->
                <LinearLayout
                    android:id="@+id/home_shortcuts_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="40dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_shortcuts_header"
                        android:textColor="@color/home_header_text"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/home_shortcuts_show_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_show_all_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:visibility="gone"
                        android:text="@string/home_shortcuts_show_all"
                        android:textColor="@color/home_subheader_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Shortcuts grid: 4 columns × 2 rows of most-visited sites.
                     Populated from the same most-visited data source as the
                     autocomplete strip (real usage, no hardcoded sites). -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_shortcuts_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingVertical="8dp"
                    android:visibility="gone" />

                <!-- Privacy tracker capsule -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_tracker_capsule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/home_capsule_bg"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_shield_check" />

                        <TextView
                            android:id="@+id/home_tracker_capsule_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/home_header_text"
                            android:textSize="13sp"
                            tools:text="4 trackers blocked" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Jump back in section header — shown only when there is at
                     least one recent tab; "Show all >" only with multiple. -->
                <LinearLayout
                    android:id="@+id/home_jump_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="60dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_jump_back_in"
                        android:textColor="@color/home_header_text"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/home_jump_show_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_show_all_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:visibility="gone"
                        android:text="@string/home_shortcuts_show_all"
                        android:textColor="@color/home_subheader_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Jump back in: horizontally scrolling recent-tab cards -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_jump_back_in"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingVertical="8dp"
                    android:visibility="gone" />

            </LinearLayout>

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:background="?attr/colorSurfaceContainerLow"
        android:visibility="gone" />

    <!--
        Middle slot shows the flat Bookmarks button in-bar (no
        hideMiddleSlot) - the URL bar at the top covers search, so the
        centre slot is the bookmarks-list entry. (The former hero
        Bookmarks FAB was removed.)
    -->

    <!--
        Single top bar (Item 2): the toolbar hosts shield → address pill →
        flame download → + → tab counter → menu. This view remains as a
        zero-height, GONE controller so the fragments' onBadgeCount /
        onTabsCount / updateTheme calls keep a target (the buttons they
        control now live in the toolbar's top_bar_actions cluster).
    -->
    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <View
        android:id="@+id/navigation_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
